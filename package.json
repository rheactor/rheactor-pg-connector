{
  "name": "@rheactor/rheactor-pg-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Rheactor PG Connector.",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./serverless": {
      "types": "./dist/index.serverless.d.mts",
      "import": "./dist/index.serverless.mjs"
    }
  },
  "scripts": {
    "build": "bun run test && bun run lint && tsdown",
    "lint": "bun run typecheck && bun run oxlint && bun run oxfmt",
    "lint:fix": "bun run typecheck && bun run oxlint:fix && bun run oxfmt:fix",
    "oxfmt": "oxfmt --check ./src ./tests",
    "oxfmt:fix": "oxfmt --write ./src ./tests",
    "oxlint": "oxlint ./src ./tests",
    "oxlint:fix": "oxlint --fix ./src ./tests",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@rheactor/rheactor-oxc-config": "github:rheactor/rheactor-oxc-config",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "next": "^16.3.4",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "next": "^16.3.4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
