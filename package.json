{
  "name": "@rheactor/rheactor-pg-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Rheactor PG Connector.",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./serverless": {
      "types": "./dist/index.serverless.d.mts",
      "import": "./dist/index.serverless.mjs"
    }
  },
  "scripts": {
    "build": "npm run lint && tsdown",
    "lint": "npm run typecheck && npm run oxlint && npm run oxfmt",
    "lint:fix": "npm run typecheck && npm run oxlint:fix && npm run oxfmt:fix",
    "oxfmt": "oxfmt --check ./src ./tests",
    "oxfmt:fix": "oxfmt --write ./src ./tests",
    "oxlint": "oxlint ./src ./tests",
    "oxlint:fix": "oxlint --fix ./src ./tests",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@rheactor/rheactor-oxc-config": "github:rheactor/rheactor-oxc-config",
    "@types/pg": "^8.21.0",
    "next": "^16.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "next": "^16.3.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
